{
  "name": "puna-tech-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port=3000 --host=0.0.0.0",
    "build": "react-router build",
    "preview": "react-router-serve ./build/server/nodejs_*/index.js",
    "lint": "tsc --noEmit",
    "test:workflows": "node scripts/validate-n8n-workflows.mjs",
    "test:seo": "node scripts/verify-build-seo.mjs",
    "test:safety": "node --experimental-strip-types scripts/verify-content-safety.mjs",
    "test:content-worker": "node --experimental-strip-types scripts/test-content-worker-client.mjs",
    "test:social-studio": "node --experimental-strip-types scripts/test-social-studio.mjs",
    "test:worker-bundle": "node scripts/verify-content-worker-bundle.mjs",
    "verify:content-worker": "node --env-file=.env.local --experimental-strip-types scripts/verify-content-worker.mjs",
    "verify:social-studio": "node --env-file=.env.local --experimental-strip-types scripts/verify-social-studio.mjs",
    "import:legacy-brand-assets": "node --env-file=.env.local scripts/import-autopost-brand-assets.mjs",
    "test": "npm run lint && npm run test:workflows && npm run test:safety && npm run test:content-worker && npm run test:social-studio && npm run build && npm run test:worker-bundle && npm run test:seo"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@react-router/node": "7.18.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.106.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/react-router": "^1.3.4",
    "isbot": "^5",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "7.18.2",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
